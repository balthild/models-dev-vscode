{
	"include": [
		"./*.config.ts",
		"./build/**/*.ts",
		"./src/**/*.ts",
		"./test/**/*.ts",
		"./scripts/**/*.ts",
	],
	"compilerOptions": {
		"paths": {
			"#/*": ["./src/*"],
			"#build/*": ["./build/*"],
		},
		"lib": ["esnext"],
		"types": ["node"],
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"strict": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"noEmit": true,
	},
}
