{
	"name": "models-dev-vscode",
	"displayName": "Models.dev",
	"version": "0.1.2",
	"private": true,
	"description": "Models.dev as copilot model providers",
	"categories": [
		"AI",
		"Other"
	],
	"repository": "https://github.com/balthild/models-dev-vscode",
	"license": "GPL-3.0-only",
	"publisher": "balthild",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"main": "./dist/extension.js",
	"files": [
		"dist",
		"assets",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "rolldown -c",
		"build:prod": "rolldown -c --minify",
		"watch": "rolldown -c --watch",
		"clean": "rm -rf ./dist",
		"check": "tsc -p . && run fmt:check",
		"test": "node --import ./test/vscode-hook.ts --test 'test/**/*.test.ts'",
		"snapshot": "node scripts/generate-snapshot.ts",
		"ranks": "node scripts/fetch-ranks.ts",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "dprint fmt",
		"fmt:check": "dprint check --list-different || echo Some files are not formatted.",
		"vscode:prepublish": "run check && run lint && run clean && run build:prod",
		"release": "release-it",
		"package": "vsce package --no-dependencies"
	},
	"contributes": {
		"languageModelChatProviders": [
			{
				"vendor": "modelsdev",
				"displayName": "Models.dev",
				"managementCommand": "modelsdev.addProvider",
				"configuration": {
					"type": "object",
					"required": [
						"provider",
						"apiKey"
					],
					"properties": {
						"provider": {
							"type": "string",
							"title": "Provider",
							"description": "models.dev provider id, such as deepseek or commandcode. See https://models.dev."
						},
						"apiKey": {
							"type": "string",
							"title": "API Key",
							"secret": true,
							"description": "API key for the provider. Stored in VS Code's secret storage."
						},
						"baseUrl": {
							"type": "string",
							"title": "Base URL",
							"description": "Endpoint to use instead of the one models.dev publishes. Leave empty for the default."
						}
					}
				}
			}
		],
		"commands": [
			{
				"command": "modelsdev.addProvider",
				"title": "Add Provider",
				"category": "Models.dev"
			},
			{
				"command": "modelsdev.updateData",
				"title": "Update Model Data",
				"category": "Models.dev"
			},
			{
				"command": "modelsdev.showStatus",
				"title": "Show Model Data Status",
				"category": "Models.dev"
			}
		]
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"dependencies": {
		"@earendil-works/pi-ai": "^1.5.2",
		"@microsoft/tiktokenizer": "^1.0.10"
	},
	"devDependencies": {
		"@oxlint/plugins": "^1.93.0",
		"@types/node": "^24.19.2",
		"@types/vscode": "^1.140.0",
		"@vscode/dts": "^0.4.1",
		"@vscode/vsce": "^4.1.1",
		"dprint": "^0.64.3",
		"oxlint": "^1.93.0",
		"oxlint-tsgolint": "^7.0.2007",
		"release-it": "^21.1.2",
		"rolldown": "^1.3.2",
		"typescript": "^7.0.2"
	},
	"packageManager": "yarn@4.18.1",
	"engines": {
		"vscode": "^1.142.0"
	}
}
