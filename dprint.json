{
	"excludes": [
		"*.lock",
	],
	"useTabs": true,
	"indentWidth": 2,
	"lineWidth": 100,
	"oxc": {
		"quoteStyle": "single",
		"quoteProperties": "consistent",
		"jsdoc": true,
		"experimentalSortImports": {
			"groups": [
				["style", "side_effect_style"],
				["builtin"],
				["external"],
				["internal", "subpath"],
				["parent", "sibling", "index"],
				["unknown"],
			],
			"internalPattern": ["#/"],
		},
	},
	"json": {
		"trailingCommas": "jsonc",
		"jsonTrailingCommaFiles": [
			"tsconfig.json",
			"dprint.json",
			".vscode/*.json",
		],
	},
	"markdown": {
		"textWrap": "always",
		"table.cellPadding": "space",
	},
	"plugins": [
		// json must be loaded before oxc, or json files will be formatted by oxc
		"npm:@dprint/json@0.25.2",
		"npm:@dprint/oxc@0.46.0",
		"npm:@dprint/markdown@0.28.2",
	],
}
